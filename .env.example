# Copy to .env (next to compose.yaml) and adjust. All values are optional;
# defaults shown. Compose reads .env from this folder on `docker compose up`.
CAPACITY=8          # number of parking spots, a whole number of at least 1
RATE_PER_HOUR=12.0  # price per hour, 0 or more
REDIS_PORT=6379     # port Redis listens on inside the compose network; the backend follows it
